# Admin panelini korumak icin sifre (HTTP Basic Auth). Kullanici adi onemli degil, sadece bu sifre kontrol edilir.
ADMIN_PASSWORD=degistir-bu-sifreyi

# Sunucunun disariya acacagi port. Railway bunu kendisi ayarlar, lokal gelistirmede 3000 kalabilir.
PORT=3000

# Public olarak erisilecek taban adres. QR kod uretirken ve panelde "karta yazilacak adres"i gostermek icin kullanilir.
# Lokal: http://localhost:3000  |  Railway: https://<proje-adi>.up.railway.app
APP_BASE_URL=http://localhost:3000

# JSON veri dosyalarinin tutulacagi klasor. Lokal: ./data | Railway'de kalici bir Volume'a baglanacak (orn. /data)
DATA_DIR=./data
